rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function short(v, n) { return v is string && v.size() > 0 && v.size() <= n; }
    // Pas de suivi le samedi et le dimanche (heure du Cameroun, UTC+1). Le 1er janvier 1970 était un jeudi.
    function isWorkday() {
      let day = math.floor((request.time.toMillis() + 3600000) / 86400000);
      let w = (day + 4) % 7;
      return w != 0 && w != 6;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
                    && short(request.resource.data.name, 80);
      allow update, delete: if isAdmin();
    }

    match /zones/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'r'])
        && short(request.resource.data.name, 60)
        && request.resource.data.r is number && request.resource.data.r >= 50 && request.resource.data.r <= 50000;
      allow delete: if isAdmin();
    }

    match /alerts/{id} {
      allow read: if isAdmin();
      allow create: if verified() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['id', 't', 'level', 'type', 'deviceId', 'device', 'ownerUid', 'text'])
        && short(request.resource.data.text, 200);
    }

    // Journal d'audit : lecture admin, ajout seulement (jamais de modification ni de suppression).
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.user == request.auth.token.email
        && request.resource.data.keys().hasOnly(['t', 'user', 'action', 'detail'])
        && short(request.resource.data.action, 80) && request.resource.data.detail is string && request.resource.data.detail.size() <= 200;
    }

    match /devices/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if verified() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'brand', 'color', 'userName', 'type', 'status', 'pendingAction', 'position', 'createdAt'])
        && short(request.resource.data.name, 60) && short(request.resource.data.brand, 60) && short(request.resource.data.userName, 80)
        && request.resource.data.type in ['phone', 'tablet', 'computer']
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
      allow update: if isAdmin() || (
        signedIn() && resource.data.ownerUid == request.auth.uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position', 'lastSeen', 'stats']) && isWorkday())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingAction'])
              && (request.resource.data.pendingAction == null || request.resource.data.pendingAction in ['disconnect', 'delete']))));
      allow delete: if isAdmin();
    }
  }
}
